# Copy to .env and fill in. .env is gitignored and excluded from the Docker image.
NEW_DISCORD_TOKEN=your-bot-token-here

# Multi-server: Discord server id that owns pre-existing likes/playlists (one-time migration).
# Required only when more than one guild already has settings/history. Example:
# ARKEN_HOME_GUILD=731372434690670633

# If 1, leave Discord servers that are pending/revoked instead of staying silent.
# ARKEN_LEAVE_UNAPPROVED=0

# --- Multi-token pool (optional) ---
# Pre-create Discord applications; Arken cannot mint tokens. Run one container/process per token.
# Shared ./data holds allowed_guilds.json + token_pool.json so every process sees the same map.
#
# Naming: token id = city (bot), auto callsign = guild seat on that bot.
# Support id looks like "Osgiliath · East Bank" after !allowguild (sticky, automatic).
# Catalog cities: gondor, osgiliath, nimloth, morthond (5 seats each).
# Guild→token assignment locks when that city's bot joins via OAuth invite (not when !allowguild runs).
#
# ARKEN_TOKEN_POOL=gondor,osgiliath,nimloth,morthond
# ARKEN_TOKEN_ID=gondor
# ARKEN_MAX_GUILDS_PER_TOKEN=5
# Load score weights (guild count, concurrent players, log1p(members)):
# ARKEN_POOL_WEIGHT_GUILD=10
# ARKEN_POOL_WEIGHT_ACTIVE=8
# ARKEN_POOL_WEIGHT_MEMBERS=1
# Prometheus textfile under data/metrics/ (set 0 to disable):
# ARKEN_METRICS=1
# See docker-compose.pool.yml for a multi-container example.
#
# Legacy GONDOR_* names still work (deprecated).

# First boot on a fresh server: comma-separated Discord user ids → auto-added as owners in data/user_whitelist.json
# ARKEN_BOOTSTRAP_OWNERS=644775712548454400

# Optional toggles (see README). Examples:
# ARKEN_AUTO_UPDATE_DEPS=1
# ARKEN_AUTO_UPDATE_YTDLP_ONLY=1
# ARKEN_GIFS=1